{
  "name": "taply",
  "version": "0.1.0",
  "private": true,
  "description": "Taply — site statique + API backend (Hono sur Vercel Functions).",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/build-static.mjs && node --watch --import ./scripts/dev-ts-hooks.mjs scripts/dev-server.ts",
    "dev:api": "node --watch --import ./scripts/dev-ts-hooks.mjs scripts/dev-server.ts --api-only",
    "build:static": "node scripts/build-static.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/visual/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test -c tests/visual/playwright.config.ts",
    "check": "npm run typecheck && npm run test",
    "db:migration:new": "supabase migration new",
    "db:migrations:list": "supabase migration list",
    "db:push:dry": "supabase db push --dry-run",
    "db:push": "supabase db push",
    "db:lint": "supabase db lint --linked --schema taply --fail-on error",
    "db:reliability": "node --import ./scripts/dev-ts-hooks.mjs scripts/certification/db-runtime-reliability.ts",
    "db:loyalty:cert": "node --import ./scripts/dev-ts-hooks.mjs scripts/certification/loyalty-postgres.mjs",
    "dev:e2e": "node --import ./scripts/dev-ts-hooks.mjs scripts/dev-local-e2e.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "hono": "4.13.13",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@hono/node-server": "2.1.3",
    "@playwright/test": "1.61.0",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.5",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "supabase": "2.120.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
