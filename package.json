{
  "name": "taply",
  "version": "0.1.0",
  "private": true,
  "description": "Taply — site statique + API backend (Hono sur Vercel Functions).",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/visual/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test -c tests/visual/playwright.config.ts",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "hono": "4.13.13",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@types/node": "24.19.1",
    "@types/pngjs": "6.0.5",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
