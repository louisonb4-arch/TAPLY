{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build-static.mjs",
  "outputDirectory": "dist",
  "routes": [
    { "handle": "filesystem" },
    { "src": "^/api(?:/.*)?$", "dest": "/api" },
    { "src": "^/.*$", "status": 404, "dest": "/404.html" }
  ]
}
