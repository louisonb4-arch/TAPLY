# Copier en .env (jamais suivi par git) et renseigner les valeurs réelles.
# Aucune valeur ici — noms de variables uniquement.

# Phase 1 — URLs publiques (optionnelles, HTTPS obligatoire en staging/production)
PUBLIC_BASE_URL=
MERCHANT_APP_BASE_URL=
JOIN_BASE_URL=
WALLET_WEB_SERVICE_URL=

# Phase 2 — base de données
# Transaction Pooler Supabase, rôle taply_app (jamais le rôle postgres/admin).
# Dashboard taply-staging → Project Settings → Database → Connection string
# → onglet "Transaction pooler". NE PAS inclure sslmode/sslcert/sslkey/
# sslrootcert dans cette URL en staging/production — TLS géré exclusivement
# par backend/db/pool.ts (objet ssl explicite + DATABASE_CA_CERT ci-dessous).
DATABASE_URL_APP=

# Certificat CA PEM de Supabase, pour vérification stricte du certificat
# serveur + hostname (pas seulement le magasin de confiance système).
# Dashboard taply-staging → Project Settings → Database → SSL Configuration
# → télécharger le certificat. Format attendu :
#   -----BEGIN CERTIFICATE-----
#   ...
#   -----END CERTIFICATE-----
# Obligatoire en staging/production dès que DATABASE_URL_APP est défini. Si
# votre plateforme n'accepte pas les retours à la ligne réels dans une
# variable d'environnement, des "\n" littéraux sont acceptés et normalisés
# automatiquement.
DATABASE_CA_CERT=
